# Copy to .env and fill in. Nothing here is a business setting: shop details, accounts, addresses, payment options and
# API keys are all set inside the apps. This file only says where things run and holds the machine's own secrets.
# Make a password with:  openssl rand -base64 24 | tr -d '/+='    (letters and numbers only)

# --- Images ---
# Where the apps' images are published. For GitHub that is ghcr.io and your GitHub user or organisation name.
IMAGE_REGISTRY=ghcr.io
IMAGE_OWNER=modnite
# Pin a version for production (1.4.0, or sha-3f9c2ab). "latest" follows the newest release.
THRICE_TAG=latest
SITE_TAG=latest

# --- Addresses ---
# One name for each app. Leave both blank on a test machine and use the ports below instead.
# Point each name's DNS at this server before starting. HTTPS certificates are automatic.
ADMIN_DOMAIN=
SITE_DOMAIN=
# Full control over what Caddy answers on (rarely needed). Examples:
#   ADMIN_ADDR=http://admin.example.com        plain http, when a Cloudflare Tunnel already does HTTPS
#   SITE_ADDR=example.com, www.example.com     several names for the website
#ADMIN_ADDR=
#SITE_ADDR=
# With no domains the apps answer on ports 8080 (THRICE) and 8081 (website). Loopback only unless you set 0.0.0.0.
LAN_BIND=127.0.0.1
# Change these when another service on the machine already uses the port (OpenMediaVault uses 80 and 443).
#ADMIN_PORT=8080
#SITE_PORT=8081
#HTTP_PORT=80
#HTTPS_PORT=443

# --- Database ---
# postgres is the server's own admin login. The other two are each app's private login.
POSTGRES_PASSWORD=
THRICE_DB_PASSWORD=
SITE_DB_PASSWORD=

# --- Secrets ---
# The website requires a long random value (32+ characters). THRICE's is optional: it keeps the key that encrypts saved
# mail passwords apart from the database. Changing either later makes what it protected unreadable.
SITE_APP_SECRET=
THRICE_APP_SECRET=

# --- Website first start ---
# The website creates its first admin from these on first start, then you can clear them.
SITE_ADMIN_EMAIL=
SITE_ADMIN_NAME=
SITE_RUN_SEED_ON_BOOT=true
# Your time zone, for example America/New_York. Booking times are read in it.
SITE_TZ=UTC
# true = the website starts with made-up sample content (for a demo). Leave false for a real site.
SITE_SEED_DEMO=false
# local = bookings stay on the website, thrice = they go into THRICE. Better set in the website admin (System & backend).
SITE_RENTAL_BACKEND=local
# Website email and bot protection. All of it can also be left empty and set later.
SITE_SMTP_HOST=
SITE_SMTP_PORT=587
SITE_SMTP_USER=
SITE_SMTP_PASS=
SITE_SMTP_FROM=
SITE_NOTIFY_EMAIL=
SITE_TURNSTILE_SITE_KEY=
SITE_TURNSTILE_SECRET_KEY=

# --- Backups ---
BACKUP_KEEP_DAYS=14
# To also copy backups off this machine: COMPOSE_PROFILES=offsite and the settings below.
# Example for an S3-style service such as Backblaze B2:
#   RCLONE_TYPE=s3  RCLONE_PROVIDER=Other  RCLONE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#   RCLONE_KEY_ID=...  RCLONE_KEY_SECRET=...  RCLONE_REMOTE=my-bucket/backups
#COMPOSE_PROFILES=offsite
RCLONE_REMOTE=
RCLONE_TYPE=
RCLONE_PROVIDER=
RCLONE_ENDPOINT=
RCLONE_KEY_ID=
RCLONE_KEY_SECRET=
